apiVersion: v1
kind: Service
metadata:
  name: mariadb
  labels:
    app.kubernetes.io/managed-by: Rockpool
    app.kubernetes.io/instance: rockpool-mariadb
    app.kubernetes.io/name: mariadb
spec:
  ports:
    - name: mariadb
      port: 3306
  selector:
    app.kubernetes.io/instance: rockpool-mariadb
    app.kubernetes.io/name: mariadb

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mariadb
  labels:
    app.kubernetes.io/managed-by: Rockpool
    app.kubernetes.io/instance: rockpool-mariadb
    app.kubernetes.io/name: mariadb
spec:
  selector:
    matchLabels:
      app.kubernetes.io/instance: rockpool-mariadb
      app.kubernetes.io/name: mariadb
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: rockpool-mariadb
        app.kubernetes.io/name: mariadb
    spec:
      containers:
      - name: mariadb
        image: mariadb:latest
        ports:
          - containerPort: 3306
